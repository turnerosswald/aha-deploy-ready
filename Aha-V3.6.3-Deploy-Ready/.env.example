# Copy to .env and add your own key. NEVER share or commit this file.
# Key stays on the Node server (NOT in VITE_ variables or frontend code).
OPENAI_API_KEY=api-key-here
# gpt-4.1-mini supports the structured tutor outputs used in this app.
OPENAI_MODEL=gpt-6-luna
# Optional: set a random, stable secret for signed lesson steps in production.
# Example generation: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AI_SIGNING_SECRET=
# Local single-process cost guard (NOT a substitute for production user quotas).
AI_REQUESTS_PER_HOUR=36
API_PORT=3001
