# LOCAL DEVELOPMENT ONLY. Copy to .env and replace values locally.
# NEVER commit .env to GitHub or paste your secret key in chats/screenshots.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
API_PORT=3001
AI_REQUESTS_PER_HOUR=36

# Production Vercel private preview: add these in Project Environment Variables.
# Choose a strong unique password (at least 12 characters); not a provider API key.
SITE_ACCESS_PASSWORD=
# Recommended: generate with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AI_SIGNING_SECRET=

# Optional durable usage tracking + shared daily REQUEST limit (Upstash Redis REST).
# Both fields must be configured; NEVER put these in a VITE_ frontend variable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Only set AI_DAILY_REQUEST_LIMIT when shared Redis is configured. Otherwise
# AI operations fail closed rather than pretending per-instance quotas are secure.
AI_DAILY_REQUEST_LIMIT=

# Optional cost estimates. Fill with verified US-dollar costs for the actual model.
# These are $/1 million tokens. When blank, the app shows tokens but not dollars.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
